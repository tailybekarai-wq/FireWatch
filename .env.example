# FireWatch environment variables — template only, NO real values here.
# Copy to .env for local development. In production these live in
# GitHub Secrets / Render Env / Vercel Env (see docs/DEPLOYMENT_PLAN.md §2).

# Names match `neon env pull` (.env.local) and the GitHub Actions secrets.

# --- pipeline (GitHub Actions) ---
FIRMS_MAP_KEY=
# Pooled Neon URL (host with -pooler): ingestion writes
DATABASE_URL=
# Area of interest W,S,E,N (optional; defaults to Kazakhstan)
AOI_BBOX=46.4,40.5,87.4,55.5

# --- migrations and bulk loads ---
# Direct Neon URL (host without -pooler): Alembic, region loading, pg_dump
DATABASE_URL_UNPOOLED=

# --- api (Render) ---
DATABASE_URL_READER=
CORS_ORIGINS=http://localhost:3000

# --- ml (training workflow) ---
EARTHDATA_TOKEN=

# --- optional: Copernicus Data Space (Sentinel-2 dNBR) ---
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- web (Vercel) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAP_STYLE_URL=
